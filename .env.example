# Keep credentials in .env, which is ignored. Existing GROQ_API_KEY/GROQ_MODEL work.
ENVIRONMENT=local
MODEL_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
MODEL_TIMEOUT_SECONDS=90

# Defaults for backend/compose.yaml. Local mode always uses emulator endpoints.
GOOGLE_CLOUD_PROJECT=home-safety-local
FIRESTORE_DATABASE_ID=(default)
PHOTOS_BUCKET=home-safety-local-photos
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443

# Optional locally; required in production. Send Authorization: Bearer <token>.
# DEMO_BEARER_TOKEN=replace-with-a-private-demo-token
