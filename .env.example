# Keep backend credentials in .env, which is ignored.
ENVIRONMENT=local
MODEL_PROVIDER=muse
MUSE_API_KEY=replace-with-your-meta-key
MUSE_MAIN_MODEL=muse-wonder-1.0
# Optional on-demand highlighting; run a separate local annotation worker.
MUSE_SEGMENTATION_MODEL=sam-3.1
# Optional: enable automatic room concepts with your available Muse image model.
MUSE_IMAGE_GEN_MODEL=
# Optional alternative: select MODEL_PROVIDER=groq explicitly. No automatic fallback.
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
MODEL_TIMEOUT_SECONDS=90

# Defaults for backend/compose.yaml. Local mode always uses emulator endpoints.
GOOGLE_CLOUD_PROJECT=home-safety-local
FIRESTORE_DATABASE_ID=(default)
PHOTOS_BUCKET=home-safety-local-photos
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443

# Managed authentication: local emulator only. Remove emulator settings for cloud.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Expo launch commands read client settings here. Restart Expo after changes.
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
EXPO_PUBLIC_FIREBASE_PROJECT_ID=home-safety-local
EXPO_PUBLIC_FIREBASE_API_KEY=local-emulator-key
EXPO_PUBLIC_FIREBASE_APP_ID=home-safety-local
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=home-safety-local.firebaseapp.com

# Cloud deployment only: use a verified test account and the cloud Firebase client
# values above. The deploy script signs in for fresh tokens on each invocation.
# Keep these credentials private; never use EXPO_PUBLIC_ for them.
# HOME_SAFETY_SMOKE_EMAIL=
# HOME_SAFETY_SMOKE_PASSWORD=
# Alternatively supply a current Firebase ID token (overrides email/password):
# HOME_SAFETY_SMOKE_ID_TOKEN=
