#!/bin/bash
# Runs as root on every boot. Never enable shell tracing: the demo token is private.
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y nginx python3 python3-venv curl ca-certificates

if ! id home-safety >/dev/null 2>&1; then
  useradd --system --home-dir /opt/home-safety-ai --shell /usr/sbin/nologin home-safety
fi
install -d -m 0755 /opt/home-safety-ai /var/lib/home-safety-acme/.well-known/acme-challenge
install -d -m 0750 -o root -g home-safety /etc/home-safety-ai

if [ ! -s /etc/home-safety-ai/demo-token ]; then
  python3 -c 'import secrets; print(secrets.token_hex(32))' > /etc/home-safety-ai/demo-token
fi
chmod 0600 /etc/home-safety-ai/demo-token

# Generate the nginx authentication map without logging or interpolating the token
# into Terraform metadata. nginx's root master process reads this private file.
python3 - <<'PY'
from pathlib import Path
token = Path('/etc/home-safety-ai/demo-token').read_text().strip()
config = 'map_hash_bucket_size 128;\nmap $http_authorization $home_safety_authorized {\n    default 0;\n    "Bearer ' + token + '" 1;\n}\n'
path = Path('/etc/nginx/conf.d/home-safety-token.conf')
path.write_text(config)
path.chmod(0o600)
PY

cat > /etc/home-safety-ai/backend.env <<'ENV'
GOOGLE_CLOUD_PROJECT=${project_id}
FIRESTORE_DATABASE_ID=${database_id}
PHOTOS_BUCKET=${photos_bucket}
ENV
chown root:home-safety /etc/home-safety-ai/backend.env
chmod 0640 /etc/home-safety-ai/backend.env

# Only the ACME challenge is served over HTTP. No app route accepts HTTP uploads.
cat > /etc/nginx/sites-available/home-safety-http <<'NGINX'
server {
    listen 80 default_server;
    server_name ${public_ip};
    access_log off;
    location /.well-known/acme-challenge/ {
        root /var/lib/home-safety-acme;
    }
    location / { return 404; }
}
NGINX
rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/home-safety-http /etc/nginx/sites-enabled/home-safety-http
chmod 0644 /etc/nginx/sites-available/home-safety-http
chmod 0755 /var/lib/home-safety-acme /var/lib/home-safety-acme/.well-known /var/lib/home-safety-acme/.well-known/acme-challenge
nginx -t
systemctl enable --now nginx
systemctl reload nginx

# Distribution Certbot packages can predate IP-certificate support. Keep Certbot
# isolated and pin a release supporting IP webroot validation (>=5.4).
if [ ! -x /opt/home-safety-certbot/bin/certbot ]; then
  python3 -m venv /opt/home-safety-certbot
fi
/opt/home-safety-certbot/bin/pip install --disable-pip-version-check 'certbot==5.8.0'

cat > /usr/local/sbin/home-safety-tls <<'TLS'
#!/bin/bash
set -euo pipefail
umask 077
/opt/home-safety-certbot/bin/certbot certonly \
  --non-interactive --agree-tos --email '${certificate_email}' \
  --server https://acme-v02.api.letsencrypt.org/directory \
  --preferred-profile shortlived --cert-name home-safety-ip \
  --webroot --webroot-path /var/lib/home-safety-acme \
  --ip-address '${public_ip}' --keep-until-expiring \
  --deploy-hook 'nginx -t && systemctl reload nginx'

cat > /etc/nginx/sites-available/home-safety-https <<'NGINX'
server {
    listen 443 ssl;
    server_name ${public_ip};
    ssl_certificate /etc/letsencrypt/live/home-safety-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/home-safety-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    access_log off;

    if ($home_safety_authorized = 0) { return 401; }

    # This checks infrastructure only; the assessment backend is not deployed yet.
    location = /infra-healthz {
        default_type application/json;
        return 200 '{"infrastructure":"ready","application":"not_deployed"}';
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
}
NGINX
chmod 0644 /etc/nginx/sites-available/home-safety-https
ln -sf /etc/nginx/sites-available/home-safety-https /etc/nginx/sites-enabled/home-safety-https
nginx -t
systemctl reload nginx
TLS
chmod 0750 /usr/local/sbin/home-safety-tls

cat > /etc/systemd/system/home-safety-tls.service <<'UNIT'
[Unit]
Description=Obtain or renew Home Safety IP certificate and reload nginx
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/home-safety-tls
UNIT

cat > /etc/systemd/system/home-safety-tls.timer <<'UNIT'
[Unit]
Description=Check Home Safety short-lived certificate every hour

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
UNIT

# A deployment contract for the future FastAPI app; intentionally not enabled.
cat > /etc/systemd/system/home-safety-backend.service <<'UNIT'
[Unit]
Description=Home Safety FastAPI backend
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/home-safety-ai/venv/bin/uvicorn

[Service]
User=home-safety
Group=home-safety
WorkingDirectory=/opt/home-safety-ai/current
EnvironmentFile=/etc/home-safety-ai/backend.env
EnvironmentFile=-/etc/home-safety-ai/secrets.env
ExecStart=/opt/home-safety-ai/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now home-safety-tls.timer
systemctl start home-safety-tls.service
