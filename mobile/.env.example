# Real API is the default. Set preview explicitly for fixture-only demos.
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# A shared demo access token is client-visible. Never put GROQ_API_KEY here.
EXPO_PUBLIC_DEMO_TOKEN=
# Android emulator: use http://10.0.2.2:8000 instead.
# Physical Android device: use your development machine's reachable LAN IP.
