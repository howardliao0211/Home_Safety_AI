{
  "expo": {
    "name": "Home Safety AI",
    "slug": "home-safety-ai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homesafetyai.mobile",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f6f1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.homesafetyai.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f6f1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 104
        }
      ],
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a room photo for your assessment.",
          "cameraPermission": "Take a room photo for your assessment.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store"
    ],
    "scheme": "home-safety",
    "extra": {
      "eas": {
        "projectId": "4829c081-8ad2-4a45-8218-9699a4900641"
      }
    },
    "owner": "howardliao0211"
  }
}
